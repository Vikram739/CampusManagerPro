PORT=5000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL=postgres://campus:campus@localhost:5432/campusmanagerpro

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS origin of the React dev server
CLIENT_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
